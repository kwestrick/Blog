library(tidyverse)
# Read current registry
reg <- read_csv("docs/blog_registry.csv", show_col_types = FALSE)
# Remove the archived "Trumps Maginot Line" post (row 55) that no longer exists on disk
reg_clean <- reg |>
filter(!(post_id == 55 & title == "Trumps Maginot Line Approach to Foreign Policy"))
# Write back
write_csv(reg_clean, "docs/blog_registry.csv")
cat("✔ Removed archived post from registry\n")
cat("Registry now has", nrow(reg_clean), "posts\n")
