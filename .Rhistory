require(rgdal)
require(raster)
library(ggplot2)
# Wecc Shapefile (created )
nercRegionsSh <- readOGR(paste0(climaticsDataDir,"HIFLD/NERC_Regions"))
names(nercRegionsSh)
nercRegionsSh$SHAPE__Are
nercRegionsSh$NAME
weccSouth <- nercRegionsSh[c(1:2),]
data.frame(weccSouth)
#plot(weccSouth, col = rainbow(4))
weccShape <- nercRegionsSh[c(1:2,6:7),]
weccShapeFortify <- fortify(weccShape)
weccBdry <- rgeos::gUnaryUnion(nercRegionsSh[c(1:2,6:7),])
US <- getData('GADM',country='USA',level=1)
birchWecc <- US[c(3,5,6,13,27,29,32,38,45,48,51),]
birchWeccBdry <- rgeos::gUnaryUnion(birchWecc)
plot(birchWeccBdry)
birchWeccFortify <- fortify(birchWecc)
birchWeccBdryFortify <- fortify(birchWeccBdry)
birchShapes <- list(weccBdry = birchWeccBdry)
#saveRDS(birchShapes,file = paste0(climaticsCodeDir,"Birch/birchShapes.rds"))
myLocation <- extent(birchWeccBdry)
rm(myMap)
myMap <- ggmap::get_map(location = c(myLocation[1,],myLocation[3,],myLocation[2,],myLocation[4,]))
ggmap::ggmap(myMap)  +
geom_polygon(aes(x = long, y = lat, group = group), data = birchWeccFortify,
colour = 'red', fill = 'transparent', alpha = .15, size = .5, linetype = 3) +
geom_polygon(aes(x = long, y = lat, group = group), data = birchWeccBdryFortify,
colour = 'black', fill = 'transparent', alpha = .15, size = 1.5)
names(nationalParks)
